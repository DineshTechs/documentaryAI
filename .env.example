# Copy to .env and fill in.

# Your domain, pointed at the server's IP with a DNS A record (Caddy uses it for the free HTTPS certificate).
DOMAIN=studio.example.com

# Not needed: the app detects its own address (YouTube callback, Telegram links) from the browser.
# BASE_URL=https://studio.example.com

# Password to log in to the app.
APP_PASSWORD=change-this-to-a-long-password

# Random string for session cookies. Generate one with: openssl rand -hex 32
SECRET_KEY=replace-with-random-hex

# Optional tuning
# AGENT_MAX_STEPS=80          # agent tool steps per run before it pauses
# BASH_MAX_TIMEOUT=3600       # longest single command (renders), in seconds
