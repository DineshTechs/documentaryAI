# Copy to .env (or set these as "Environment variables" in cPanel > Setup Node.js App).

# Password to log in to the web app.
APP_PASSWORD=change-this-to-a-long-password

# Long random text used to sign login cookies.
SECRET_KEY=replace-with-40-plus-random-characters

# Database (optional, recommended on hosting). Without it, data is kept in files in data/.
# MongoDB Atlas: Database > Connect > Drivers. Use a different MONGODB_DB for each copy (main, staging, your PC).
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# MONGODB_DB=documentary_studio

# Optional ------------------------------------------------------------------
# PORT=3000                 # local/VPS only; cPanel sets this itself
# BASE_URL=https://studio.yourchannel.in   # normally detected automatically
# DATA_DIR=./data           # where films, settings and the database are kept
# RENDER_THREADS=1          # limit ffmpeg threads on shared hosting
# RENDER_PRESET=veryfast    # x264 speed: ultrafast (fastest, bigger files) ... medium (slower, smaller)
# FFMPEG_PATH=/home/USER/documentaryAI/ffmpeg   # if ffmpeg-static could not be installed
# AGENT_MAX_STEPS=80        # agent steps per run before it pauses
